# PlainScript full-stack auth template: HTTP API.
#
#   plainscript run src/app.pln
#   curl localhost:3000/health
#   curl -X POST localhost:3000/api/auth/register \
#        -H 'content-type: application/json' \
#        -d '{"username":"ada","email":"ada@example.com","password":"correct horse"}'
#
# Passwords are stored as scrypt hashes with a per-user random salt. Session
# tokens are random and are returned to the caller; the browser client stores
# the token in a cookie. The in-memory store keeps the template dependency-free
# and is the single place to swap in a database.

import { serve, json, notFound, urlOf, requestJson } from "std/http"
import { print, env } from "std/io"
import { parseNumber, split, trim, startsWith, slice, length } from "std/text"
import { count, append } from "std/list"
import { isoNow } from "std/time"
import { randomBytes, scryptSync, timingSafeEqual } from "node:crypto"
import { PublicUser } from "./shared"

declare const Buffer: any

type StoredUser
    id: number
    username: text
    email: text
    salt: text
    passwordHash: text
    createdAt: text
end

let users: list of StoredUser = []
let sessions: map of text to (number or nothing) = {}
let nextId = 1

# ------------------------------------------------------------------ passwords

function hashPassword(password: text, salt: text) -> text
    return scryptSync(password, salt, 64).toString("hex") as text
end

function sameHash(left: text, right: text) -> boolean
    let candidate = Buffer.from(left, "hex") as any
    let expected = Buffer.from(right, "hex") as any
    when candidate.length != expected.length
        return false
    end
    return timingSafeEqual(candidate, expected) as boolean
end

function verifyPassword(password: text, user: StoredUser) -> boolean
    return sameHash(hashPassword(password, user.salt), user.passwordHash)
end

# --------------------------------------------------------------------- users

function publicUser(user: StoredUser) -> PublicUser
    return { id: user.id, username: user.username, email: user.email }
end

function findUserByName(username: text) -> StoredUser?
    for user in users
        when user.username == username
            return user
        end
    end
    return nothing
end

function findUserByEmail(email: text) -> StoredUser?
    for user in users
        when user.email == email
            return user
        end
    end
    return nothing
end

function findUserById(id: number) -> StoredUser?
    for user in users
        when user.id == id
            return user
        end
    end
    return nothing
end

function addUser(username: text, email: text, password: text) -> StoredUser
    let salt = randomBytes(16).toString("hex") as text
    let user: StoredUser = {
        id: nextId,
        username: username,
        email: email,
        salt: salt,
        passwordHash: hashPassword(password, salt),
        createdAt: isoNow(),
    }
    nextId += 1
    users = append(users, user)
    return user
end

# ------------------------------------------------------------------- sessions

function createSession(userId: number) -> text
    let token = randomBytes(24).toString("hex") as text
    sessions[token] = userId
    return token
end

function sessionUserId(token: text) -> number or nothing
    when token == ""
        return nothing
    end
    return sessions[token]
end

function endSession(token: text) -> nothing
    when token != ""
        sessions[token] = nothing
    end
end

# -------------------------------------------------------------- request input

function cookieValue(request: any, name: text) -> text
    let header = request.headers.get("cookie")
    when header is text
        for part in split(header, ";")
            let entry = trim(part)
            when startsWith(entry, "{name}=")
                return slice(entry, length(name) + 1)
            end
        end
    end
    return ""
end

function textField(body: any, name: text) -> text
    when body is map of text to any
        let value = body[name]
        when value is text
            return value
        end
    end
    return ""
end

# --------------------------------------------------------------------- routes

async function handler(request: any) -> any
    let url = urlOf(request)
    let method = request.method
    let path = url.pathname as text
    let token = cookieValue(request, "session")

    when method == "GET" and path == "/health"
        return json({ status: "ok", users: count(users) })
    end

    when method == "POST" and path == "/api/auth/register"
        let body = await requestJson(request)
        let username = textField(body, "username")
        let email = textField(body, "email")
        let password = textField(body, "password")
        when username == ""
            return json({ error: "username is required" }, 400)
        end
        when email == ""
            return json({ error: "email is required" }, 400)
        end
        when length(password) < 8
            return json({ error: "password must be at least 8 characters" }, 400)
        end
        when findUserByName(username) != nothing
            return json({ error: "username is already taken" }, 409)
        end
        when findUserByEmail(email) != nothing
            return json({ error: "email is already registered" }, 409)
        end
        let user = addUser(username, email, password)
        let sessionId = createSession(user.id)
        return json({ sessionId: sessionId, user: publicUser(user) }, 201)
    end

    when method == "POST" and path == "/api/auth/login"
        let body = await requestJson(request)
        let username = textField(body, "username")
        let password = textField(body, "password")
        let user = findUserByName(username)
        when user != nothing
            when verifyPassword(password, user)
                let sessionId = createSession(user.id)
                return json({ sessionId: sessionId, user: publicUser(user) }, 200)
            end
        end
        return json({ error: "invalid credentials" }, 401)
    end

    when method == "POST" and path == "/api/auth/logout"
        endSession(token)
        return json({ ok: true })
    end

    when method == "GET" and path == "/api/auth/me"
        let userId = sessionUserId(token)
        when userId != nothing
            let user = findUserById(userId)
            when user != nothing
                return json({ user: publicUser(user) })
            end
        end
        return json({ error: "not authenticated" }, 401)
    end

    when method == "GET" and path == "/api/users"
        let listed: list of PublicUser = []
        for user in users
            listed = append(listed, publicUser(user))
        end
        return json(listed)
    end

    return notFound()
end

let port = parseNumber(env("PORT", "3000"))
print("Auth API listening on http://localhost:{port}")
await serve(port, handler)

# Types shared by the backend and the browser client.
#
# Only declarations live here. PlainScript erases types at runtime, so this
# module emits no JavaScript of its own; both sides import it for checking.

export type PublicUser
    id: number
    username: text
    email: text
end

export type AuthStatus
    loggedIn: boolean
    user: PublicUser?
end

export type Session
    id: text
    userId: number
    createdAt: text
    expiresAt: text
end

export type LoginInput
    username: text
    password: text
end

export type RegisterInput
    username: text
    email: text
    password: text
end

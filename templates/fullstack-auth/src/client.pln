# Browser client for the PlainScript full-stack auth template.
#
# The DOM and the JSON global are untyped JavaScript boundaries, so they are
# reached through `declare`. Everything else — request shapes, views, auth
# state — is typed PlainScript using std/dom, std/http and std/text.

import { createElement, mount } from "std/dom"
import { fetch } from "std/http"
import { split, trim, startsWith, slice, length } from "std/text"
import { PublicUser, AuthStatus } from "./shared"

declare const document: any
declare const JSON: any

type ApiResult
    ok: boolean
    status: number
    data: any
end

let authStatus: AuthStatus = { loggedIn: false, user: nothing }
let currentUser: PublicUser or nothing = nothing

# ------------------------------------------------------------------- API layer

async function apiRequest(path: text, options?: any) -> ApiResult
    try
        let response = await fetch(path, options)
        let data = await response.json() as any
        return { ok: response.ok, status: response.status, data: data }
    catch problem
        return { ok: false, status: 0, data: nothing }
    end
end

# --------------------------------------------------------------------- cookies

function setCookie(name: text, value: text) -> nothing
    document.cookie = "{name}={value}; path=/; samesite=lax"
end

function getCookie(name: text) -> text
    let raw = document.cookie as text
    for part in split(raw, ";")
        let entry = trim(part)
        when startsWith(entry, "{name}=")
            return slice(entry, length(name) + 1)
        end
    end
    return ""
end

function clearCookie(name: text) -> nothing
    document.cookie = "{name}=; path=/; max-age=0"
end

# ----------------------------------------------------------------------- views

function field(id: text, label: text, kind: text) -> any
    return createElement("label", { className: "field" },
        label,
        createElement("input", { type: kind, id: id, placeholder: label }))
end

function button(id: text, label: text) -> any
    return createElement("button", { id: id, type: "button" }, label)
end

function loginView() -> any
    return createElement("div", { className: "auth-container" },
        createElement("h2", {}, "Login"),
        field("username", "Username", "text"),
        field("password", "Password", "password"),
        button("login-submit", "Login"),
        createElement("p", { className: "link" },
            "No account yet? ",
            createElement("a", { href: "#register", id: "go-register" }, "Register")))
end

function registerView() -> any
    return createElement("div", { className: "auth-container" },
        createElement("h2", {}, "Register"),
        field("reg-username", "Username", "text"),
        field("reg-email", "Email", "email"),
        field("reg-password", "Password", "password"),
        button("register-submit", "Register"),
        createElement("p", { className: "link" },
            "Already registered? ",
            createElement("a", { href: "#login", id: "go-login" }, "Login")))
end

function dashboardView() -> any
    let name = "there"
    when currentUser != nothing
        name = currentUser.username
    end
    return createElement("div", { className: "dashboard" },
        createElement("h1", {}, "Welcome, {name}!"),
        createElement("p", {}, "Your account is protected."),
        button("logout-btn", "Logout"))
end

function noticeView(kind: text, message: text) -> any
    return createElement("div", { className: kind }, message)
end

# ------------------------------------------------------------------- rendering

function renderPage(view: any) -> nothing
    let body = document.querySelector("body")
    body.innerHTML = ""
    mount(view, body)
end

function bindClick(id: text, handler: any) -> nothing
    let node = document.getElementById(id)
    when node != nothing
        node.onclick = handler
    end
end

function fieldValue(id: text) -> text
    let node = document.getElementById(id)
    when node != nothing
        return node.value as text
    end
    return ""
end

function showError(message: text) -> nothing
    let body = document.querySelector("body")
    mount(noticeView("error", message), body)
end

function showSuccess(message: text) -> nothing
    let body = document.querySelector("body")
    mount(noticeView("success", message), body)
end

# ------------------------------------------------------------------ auth flow

async function attemptLogin(username: text, password: text) -> boolean
    let result = await apiRequest("/api/auth/login", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ username: username, password: password }),
    })
    when result.ok
        setCookie("session", result.data?.sessionId ?? "")
        authStatus = { loggedIn: true, user: result.data?.user ?? nothing }
        currentUser = authStatus.user
        showDashboard()
        return true
    end
    showError(result.data?.error ?? "Login failed")
    return false
end

async function attemptRegister(username: text, email: text, password: text) -> boolean
    let result = await apiRequest("/api/auth/register", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ username: username, email: email, password: password }),
    })
    when result.ok
        showSuccess("Account created. Please log in.")
        showAuthPage()
        return true
    end
    showError(result.data?.error ?? "Registration failed")
    return false
end

async function attemptLogout() -> boolean
    let result = await apiRequest("/api/auth/logout", { method: "POST" })
    clearCookie("session")
    authStatus = { loggedIn: false, user: nothing }
    currentUser = nothing
    showAuthPage()
    return result.ok
end

async function refreshSession() -> boolean
    let result = await apiRequest("/api/auth/me", {
        headers: { "authorization": getCookie("session") },
    })
    when result.ok
        authStatus = { loggedIn: true, user: result.data?.user ?? nothing }
        currentUser = authStatus.user
        showDashboard()
        return true
    end
    showAuthPage()
    return false
end

# --------------------------------------------------------------------- screens

function showAuthPage() -> nothing
    renderPage(loginView())
    bindClick("login-submit", (event: any) => do
        event.preventDefault()
        attemptLogin(fieldValue("username"), fieldValue("password"))
    end)
    bindClick("go-register", (event: any) => do
        event.preventDefault()
        showRegisterPage()
    end)
end

function showRegisterPage() -> nothing
    renderPage(registerView())
    bindClick("register-submit", (event: any) => do
        event.preventDefault()
        attemptRegister(fieldValue("reg-username"), fieldValue("reg-email"), fieldValue("reg-password"))
    end)
    bindClick("go-login", (event: any) => do
        event.preventDefault()
        showAuthPage()
    end)
end

function showDashboard() -> nothing
    renderPage(dashboardView())
    bindClick("logout-btn", (event: any) => do
        event.preventDefault()
        attemptLogout()
    end)
end

# ------------------------------------------------------------------ bootstrap

refreshSession()

{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    ["\"", "\""],
    ["`", "`"],
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "surroundingPairs": [
    ["\"", "\""],
    ["`", "`"],
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(if|otherwise|make|define|function|for|repeat|while|when|route|web|database|query|insert|update|delete|execute|try|recover|finally|retry|test|match|switch|websocket|bot|whatsapp|listen|every|after|schedule|transaction|group|stream|run|mail|send|google|accept|require|enable|limit)\\b.*$",
    "decreaseIndentPattern": "^\\s*(done|end|otherwise|finally|recover)\\b.*$"
  },
  "folding": {
    "markers": {
      "start": "^\\s*(if|make|define|function|for|repeat|while|when|route|web|try|retry|test|match|switch|websocket|bot|whatsapp|transaction|group|stream)\\b",
      "end": "^\\s*(done|end)\\b"
    }
  }
}
{
    "name": "plainscript-language",
    "displayName": "PlainScript Language",
    "description": "Syntax highlighting and language support for the PlainScript programming language (.pln files)",
    "version": "1.1.0",
    "publisher": "ayoistooslick",
    "repository": {
        "type": "git",
        "url": "https://github.com/ayoistooslick/plainscript.git"
    },
    "homepage": "https://ayoistooslick.github.io/plainscript/",
    "bugs": {
        "url": "https://github.com/ayoistooslick/plainscript/issues"
    },
    "keywords": [
        "plainscript",
        "pln",
        "intent-oriented",
        "programming-language",
        "ai"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:plainscript"
    ],
    "engines": {
        "vscode": "^1.70.0"
    },
    "categories": [
        "Programming Languages",
        "Linters",
        "Snippets"
    ],
    "contributes": {
        "languages": [
            {
                "id": "plainscript",
                "aliases": [
                    "PlainScript",
                    "plainscript"
                ],
                "extensions": [
                    ".pln"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/plainscript-file.svg",
                    "dark": "./icons/plainscript-file.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "plainscript",
                "scopeName": "source.plainscript",
                "path": "./syntaxes/plainscript.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "plainscript",
                "path": "./snippets/plainscript.code-snippets"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "echo 'Prepublish complete'"
    },
    "license": "MIT"
}
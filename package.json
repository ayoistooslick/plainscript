{
  "name": "plainscript-lang",
  "version": "2.0.0",
  "description": "PlainScript: an independent, statically typed full-stack language for the JavaScript platform.",
  "author": {
    "name": "Ayodele Ayokunle David",
    "email": "davidayodele847@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ayoistooslick/plainscript.git"
  },
  "homepage": "https://github.com/ayoistooslick/plainscript#readme",
  "bugs": {
    "url": "https://github.com/ayoistooslick/plainscript/issues"
  },
  "license": "MIT",
  "type": "commonjs",
  "main": "src/index.js",
  "bin": {
    "plainscript": "./src/cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./std/*": "./stdlib/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node src/cli.js check",
    "fmt": "node src/cli.js fmt",
    "docs:build": "node scripts/build-docs-site.js",
    "demo:cli": "node src/cli.js run demos/cli/src/main.pln",
    "demo:api": "node src/cli.js run demos/api/src/server.pln",
    "demo:database": "node src/cli.js run demos/database/src/main.pln",
    "demo:realtime": "node src/cli.js run demos/realtime/src/main.pln"
  },
  "files": [
    "src",
    "stdlib",
    "templates",
    "docs",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "plainscript",
    "language",
    "compiler",
    "typescript",
    "javascript"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {},
  "devDependencies": {}
}

// PlainScript 1.0.361: upload handling and OCR.

web app
accept uploads limit "5 MB" allow list with "image/png", "image/jpeg" folder "uploads"

route post "/scan"
    remember files as uploads("document")
    if length(files) is 0
        status 400
        reply json
            error is "document is required"
        done
    otherwise
        remember document as upload("document")
        ocr path of document as text
        reply json
            text is text
        done
    done
done

start 0
// PlainScript 1.0.362: asynchronous work and error recovery.

make loadProfile(id)
    wait for sleep(10)
    give record with id id and ready true done
done

try
    remember profile as wait for loadProfile(7)
    show profile.ready
recover as err
    show message of err
finally
    show "request complete"
done

retry 3 times every 2 seconds
    show "retrying"
done
{
  "comments": {
    "lineComment": "#",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" },
    { "open": "`", "close": "`" },
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" }
  ],
  "surroundingPairs": [
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"],
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(if|else|for|while|match|case|try|catch|finally|function|async function|render|element|type|declare)\\b.*$",
    "decreaseIndentPattern": "^\\s*(end|else|case|catch|finally)\\b.*$"
  },
  "folding": {
    "markers": {
      "start": "^\\s*(if|for|while|match|try|function|async function|render|type|element)\\b",
      "end": "^\\s*end\\b"
    }
  }
}

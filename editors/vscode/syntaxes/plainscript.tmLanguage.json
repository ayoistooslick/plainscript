{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PlainScript",
  "scopeName": "source.plainscript",
  "fileTypes": ["pln"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.number-sign.plainscript", "match": "#.*$" },
        { "name": "comment.line.double-slash.plainscript", "match": "//.*$" },
        { "name": "comment.block.plainscript", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.single.plainscript", "begin": "'", "end": "'", "patterns": [{ "name": "constant.character.escape.plainscript", "match": "\\\\(?:u[0-9a-fA-F]{4}|.)" }] },
        { "name": "string.quoted.double.plainscript", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.plainscript", "match": "\\\\(?:u[0-9a-fA-F]{4}|.)" }] },
        { "name": "string.quoted.triple.plainscript", "begin": "\"\"\"", "end": "\"\"\"", "patterns": [{ "name": "constant.character.escape.plainscript", "match": "\\\\(?:u[0-9a-fA-F]{4}|.)" }] },
        {
          "name": "string.template.plainscript",
          "begin": "`",
          "end": "`",
          "patterns": [
            { "name": "constant.character.escape.plainscript", "match": "\\\\(?:u[0-9a-fA-F]{4}|.)" },
            { "name": "meta.embedded.line.plainscript", "begin": "\\$\\{", "end": "\\}", "patterns": [{ "include": "$self" }] }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.plainscript", "match": "\\b0x[0-9a-fA-F_]+\\b" },
        { "name": "constant.numeric.binary.plainscript", "match": "\\b0b[01_]+\\b" },
        { "name": "constant.numeric.plainscript", "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.plainscript", "match": "\\b(if|else|when|otherwise|for|each|in|from|to|while|match|case|try|catch|finally|throw|return|break|continue|and|or|not|is|new)\\b" },
        { "name": "keyword.declaration.plainscript", "match": "\\b(import|export|from|as|type|declare|function|define|value|set|change|returns|async|await|let|const|render|element)\\b" },
        { "name": "constant.language.plainscript", "match": "\\b(true|false|nothing)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.primitive.plainscript", "match": "\\b(number|text|boolean|nothing|any|unknown|never|error)\\b" },
        { "name": "storage.type.plainscript", "match": "\\b(list|map|Promise|of)\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.plainscript", "match": "(?:\\|>|\\?\\?|\\?\\.|->|=>|==|!=|<=|>=|\\+\\+|--|\\*\\*|[+\\-*/%<>=!?:|&])" }
      ]
    },
    "functions": {
      "patterns": [
        { "name": "entity.name.function.plainscript", "match": "\\b(function\\s+)([A-Za-z_][A-Za-z0-9_]*)" },
        { "name": "entity.name.type.plainscript", "match": "\\b(type\\s+)([A-Za-z_][A-Za-z0-9_]*)" }
      ]
    }
  }
}

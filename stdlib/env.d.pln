# Declarations for std/env. Values are read once per call; the process
# environment is mutable and shared with the host.

export declare function get(name: text) -> text?
export declare function require(name: text) -> text throws Error
export declare function number(name: text, fallback?: number) -> number throws Error
export declare function integer(name: text, fallback?: number) -> number throws Error
export declare function boolean(name: text, fallback?: boolean) -> boolean throws Error
export declare function list(name: text, separator?: text) -> list of text
export declare function all() -> map of text to text
export declare function set(name: text, value: text) -> nothing
export declare function unset(name: text) -> nothing
export declare function has(name: text) -> boolean

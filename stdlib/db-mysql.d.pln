# MySQL/MariaDB adapter backed by the application's "mysql2" dependency.
# Import std/db for the shared table/migrate helpers.

import { AsyncDatabase } from "std/db"

export type MysqlOptions
    client?: any
    driver?: any
end

export declare function open(connectionString?: text, options?: MysqlOptions) -> Promise of AsyncDatabase
export declare function openPool(connectionString?: text, options?: MysqlOptions) -> Promise of AsyncDatabase

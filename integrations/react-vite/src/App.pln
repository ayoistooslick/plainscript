#syntax 2.1

# A React component written in PlainScript 2.1 with native JSX.
#
# JSX lowers to createElement calls (classic runtime by default), so hooks,
# events and keys behave exactly as they do in a JavaScript React component.
# The generated module is an ordinary ES module that Vite bundles.

import { createElement, useState } from "react"
import { append, count, filter } from "std/list"

declare const Date: any

export type Task
    id: number
    title: text
    done: boolean
end

export define App() returns any
    set (tasks, setTasks) to useState([])
    set (draft, setDraft) to useState("")

    define remaining() returns number
        return count(filter(tasks, (task: Task) => not task.done))
    end

    define submit(event: any) returns nothing
        event.preventDefault()
        when draft is not equal to ""
            setTasks(append(tasks, { id: Date.now(), title: draft, done: false }))
            setDraft("")
        end
        return nothing
    end

    define toggle(id: number) returns nothing
        set next: list of Task to []
        for each task in tasks
            when task.id is equal to id
                change next to append(next, { id: task.id, title: task.title, done: not task.done })
            otherwise
                change next to append(next, task)
            end
        end
        setTasks(next)
        return nothing
    end

    define rows() returns list of any
        set built: list of any to []
        for each task in tasks
            change built to append(built, <li key={task.id} className="row">
                <span className="title">{task.title}</span>
                <button type="button" onClick={() => toggle(task.id)}>
                    {statusOf(task)}
                </button>
            </li>)
        end
        return built
    end

    return <main className="app">
        <h1>PlainScript + React + Vite</h1>
        <p className="muted">{remaining()} of {count(tasks)} task(s) remaining</p>
        <form onSubmit={submit}>
            <input value={draft} placeholder="What needs doing?" onChange={(event: any) => setDraft(event.target.value)} />
            <button type="submit">Add task</button>
        </form>
        <ul>{rows()}</ul>
    </main>
end

define statusOf(task: Task) returns text
    when task.done
        return "done"
    otherwise
        return "open"
    end
end
